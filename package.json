{
  "name": "pdf-editor-suite",
  "version": "2.2.0",
  "description": "Suite Integral de Edición y Manipulación de PDF en el navegador (Client-Side WebAssembly)",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "tailwindcss -i ./css/input.css -o ./css/tailwind.min.css --minify",
    "build:css": "tailwindcss -i ./css/input.css -o ./css/tailwind.min.css --minify",
    "build:check": "node scripts/check-build-fresco.mjs",
    "build:deploy": "node scripts/construir-despliegue.mjs",
    "guard": "node scripts/guards/run-all.mjs",
    "lint": "eslint .",
    "reglas:sync": "node scripts/sync-reglas.mjs",
    "reglas:check": "node scripts/sync-reglas.mjs --check",
    "version:sync": "node scripts/sync-version.mjs",
    "test:fixtures": "node tests/fixtures/generar-fixtures.mjs",
    "e2e:liberar": "node scripts/liberar-puertos.mjs",
    "dev:next": "vite",
    "build:next": "vite build",
    "preview:next": "vite preview --port 4173 --host 127.0.0.1 --strictPort",
    "preview:deploy": "node scripts/servir-despliegue.mjs --port 4174 --dir dist-deploy --config vercel.json",
    "typecheck": "tsc --noEmit",
    "test:unit:src": "vitest run",
    "test:unit": "node --test scripts/guards/*.test.mjs scripts/*.test.mjs",
    "test:e2e": "npm run test:fixtures && playwright test",
    "test:e2e:ui": "npm run test:fixtures && playwright test --ui",
    "test": "npm run test:unit && npm run test:e2e",
    "verify": "npm run reglas:check && npm run build:check && npm run lint && npm run typecheck && npm run guard && npm run test:unit && npm run test:unit:src && npm run test:e2e",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "keywords": [
    "pdf",
    "pdf-editor",
    "pdf-lib",
    "tesseract-ocr",
    "docx-preview",
    "webassembly",
    "client-side"
  ],
  "author": "PDF Editor Team",
  "license": "MIT",
  "dependencies": {
    "@embedpdf/pdfium": "^2.15.1",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^3.4.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.6.3",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
